---
import type { Project } from '../data/projects';
import Img from './Img.astro';

interface Props {
  project: Project;
  index?: number;
  size?: 'large' | 'half' | 'third';
  ratio?: string;
  class?: string;
  headingLevel?: 'h2' | 'h3';
  parallax?: boolean;
}

const { project, index, size = 'half', ratio = '4 / 5', class: className, headingLevel = 'h3', parallax = false } = Astro.props;
const Heading = headingLevel;
---

<article class:list={['pcard', className]} data-category={project.category} data-reveal>
  <a href={`/projects/${project.slug}/`} class="pcard__link" data-cursor-target="View">
    <div class="pcard__media media" style={`aspect-ratio:${ratio}`} data-parallax={parallax ? '' : undefined}>
      <Img src={project.cover.src} alt={project.cover.alt} size={size} />
    </div>
    <div class="pcard__meta">
      <div class="pcard__top">
        {index !== undefined && <span class="index-num">{String(index).padStart(2, '0')}</span>}
        <span class="pcard__cat">{project.category}</span>
        <span class="pcard__date">{project.publishedLabel}</span>
      </div>
      <Heading class="pcard__title">{project.title}</Heading>
      <p class="pcard__type">{project.type}{project.location ? ` · ${project.location}` : ''}</p>
    </div>
  </a>
</article>

<style>
  .pcard__link { display: block; }
  .pcard__media :global(img) { transition: transform 1.6s var(--ease-expo), filter 1s var(--ease-out); }
  .pcard__link:hover .pcard__media :global(img) { transform: scale(1.045); }
  .pcard__media[data-parallax] :global(img) { transition: filter 1s var(--ease-out); }
  .pcard__meta { padding-top: 1.1rem; }
  .pcard__top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    align-items: baseline;
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pcard__date { margin-left: auto; }
  .pcard__title {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 1.15rem + 1vw, 2.2rem);
    line-height: 1.08;
    letter-spacing: -0.004em;
    font-weight: 430;
  }
  .pcard__title { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; width: fit-content; transition: background-size 0.8s var(--ease-expo); padding-bottom: 2px; }
  .pcard__link:hover .pcard__title { background-size: 100% 1px; }
  .pcard__type { margin-top: 0.35rem; color: var(--muted); font-size: var(--fs-sm); }
  :global(.on-night) .pcard__top, :global(.on-night) .pcard__type { color: var(--on-night-muted); }
</style>
