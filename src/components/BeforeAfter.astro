---
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  caption?: string;
  size?: 'full' | 'large' | 'half';
  class?: string;
  start?: number;
}

const { before, after, beforeAlt, afterAlt, caption, size = 'large', class: className, start = 50 } = Astro.props;
const ratio = `${after.width} / ${after.height}`;
const id = `ba-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class:list={['ba', className]} data-ba style={`--pos:${start}%`}>
  <div class="ba__frame" style={`aspect-ratio:${ratio}`} data-ba-frame>
    <div class="ba__layer ba__after"><Img src={after} alt={afterAlt} size={size} /></div>
    <div class="ba__layer ba__before" data-ba-before><Img src={before} alt={beforeAlt} size={size} /></div>
    <span class="ba__label ba__label--before" aria-hidden="true">Before</span>
    <span class="ba__label ba__label--after" aria-hidden="true">After<span class="ba__label-x"> · Visualisation</span></span>
    <div class="ba__handle" aria-hidden="true">
      <span class="ba__knob">
        <svg viewBox="0 0 24 12" fill="none"><path d="M7 1 2 6l5 5M17 1l5 5-5 5" stroke="currentColor" stroke-width="1.2" /></svg>
      </span>
    </div>
    <label class="visually-hidden" for={id}>Compare before and after: move to reveal the original space</label>
    <input class="ba__range" id={id} type="range" min="0" max="100" step="1" value={start} data-ba-range />
  </div>
  {caption && (
    <figcaption class="caption">
      <span>{caption}</span>
      <span>Drag to compare</span>
    </figcaption>
  )}
</figure>

<style>
  .ba { position: relative; }
  .ba__frame {
    position: relative;
    overflow: hidden;
    background: var(--paper-3);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .ba__layer { position: absolute; inset: 0; }
  .ba__layer :global(img), .ba__layer :global(picture) { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .ba__before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); will-change: clip-path; }
  .ba__label {
    position: absolute;
    top: clamp(12px, 2vw, 24px);
    padding: 0.5em 0.85em;
    background: rgb(21 18 17 / 0.62);
    color: var(--on-night);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
    white-space: nowrap;
    z-index: 2;
    transition: opacity 0.4s var(--ease-out);
  }
  @media (max-width: 600px) {
    .ba__label { letter-spacing: 0.14em; padding: 0.45em 0.7em; }
    .ba__label-x { display: none; }
  }
  .ba__label--before { left: clamp(12px, 2vw, 24px); }
  .ba__label--after { right: clamp(12px, 2vw, 24px); }
  .ba__handle {
    position: absolute;
    top: 0; bottom: 0;
    left: var(--pos);
    width: 1px;
    background: var(--paper);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.15);
    pointer-events: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%; left: 50%;
    width: 64px; height: 64px;
    margin: -32px 0 0 -32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
    transition: transform 0.5s var(--ease-expo);
  }
  .ba__knob svg { width: 26px; }
  .ba.is-dragging .ba__knob { transform: scale(0.88); }
  .ba__range {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    margin: 0;
    cursor: ew-resize;
    pointer-events: none;
  }
  .ba__range:focus-visible + * { outline: none; }
  .ba__frame:has(.ba__range:focus-visible) .ba__knob { outline: 2px solid var(--wine); outline-offset: 4px; }
  @media (max-width: 600px) { .ba__knob { width: 52px; height: 52px; margin: -26px 0 0 -26px; } }
</style>
