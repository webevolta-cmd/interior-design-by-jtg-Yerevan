---
import '../styles/forms.css';
import Arrow from './Arrow.astro';
import FormSuccess from './FormSuccess.astro';
import { site } from '../data/site';

const formName = 'design-request';
const rooms = ['Whole home', 'Living room', 'Kitchen', 'Bedroom', 'Bathroom', 'Children’s room', 'Entrance & corridor', 'Wardrobe / dressing'];
const services = ['Interior design project', '3D visualisation', 'Working drawings', 'Exterior design', 'Landscape design', 'Implementation support', 'Consultation'];
---

<div class="form-wrap" data-form-wrap>
  <form
    class="form"
    name={formName}
    method="POST"
    action="/thank-you/?form=design"
    enctype="multipart/form-data"
    data-netlify="true"
    netlify-honeypot="company_website"
    data-form
    data-form-encoding="multipart"
    novalidate
  >
    <input type="hidden" name="form-name" value={formName} />
    <p class="hp" aria-hidden="true">
      <label>Leave this field empty <input name="company_website" tabindex="-1" autocomplete="off" /></label>
    </p>

    <fieldset>
      <legend class="form__legend"><span class="index-num">01</span> About you</legend>
      <div class="form__group">
        <div class="field">
          <label class="field__label" for="dr-name">Full name<span class="req" aria-hidden="true">*</span></label>
          <input id="dr-name" name="name" type="text" autocomplete="name" required minlength="2" aria-describedby="dr-name-err" />
          <p class="field__error" id="dr-name-err" data-error-for="name"></p>
        </div>
        <div class="field">
          <label class="field__label" for="dr-phone">Phone<span class="req" aria-hidden="true">*</span></label>
          <input id="dr-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="+374 …" data-validate="phone" aria-describedby="dr-phone-err" />
          <p class="field__error" id="dr-phone-err" data-error-for="phone"></p>
        </div>
        <div class="field">
          <label class="field__label" for="dr-email">Email<span class="req" aria-hidden="true">*</span></label>
          <input id="dr-email" name="email" type="email" autocomplete="email" required aria-describedby="dr-email-err" />
          <p class="field__error" id="dr-email-err" data-error-for="email"></p>
        </div>
        <div class="field">
          <span class="field__label" id="dr-contact-label">Preferred contact</span>
          <div class="choices" role="radiogroup" aria-labelledby="dr-contact-label">
            {['Phone call', 'Email', 'Instagram message'].map((v, i) => (
              <label class="choice"><input type="radio" name="preferred_contact" value={v} checked={i === 0} /><span>{v}</span></label>
            ))}
          </div>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend class="form__legend"><span class="index-num">02</span> Your project</legend>
      <div class="form__group">
        <div class="field">
          <label class="field__label" for="dr-type">Project type<span class="req" aria-hidden="true">*</span></label>
          <select id="dr-type" name="project_type" required aria-describedby="dr-type-err" data-controls>
            <option value="">Select…</option>
            <option>Residential — apartment</option>
            <option>Residential — house / villa</option>
            <option>Commercial</option>
            <option>Exterior &amp; landscape</option>
            <option>Other</option>
          </select>
          <p class="field__error" id="dr-type-err" data-error-for="project_type"></p>
        </div>
        <div class="field">
          <label class="field__label" for="dr-location">Property location</label>
          <input id="dr-location" name="location" type="text" autocomplete="address-level2" placeholder="e.g. Kentron, Yerevan" />
        </div>

        <div class="field span-2" data-show-when="project_type=Residential — apartment|Residential — house / villa">
          <span class="field__label" id="dr-rooms-label">Spaces to design</span>
          <div class="choices" role="group" aria-labelledby="dr-rooms-label">
            {rooms.map((r) => (
              <label class="choice"><input type="checkbox" name="spaces" value={r} /><span>{r}</span></label>
            ))}
          </div>
        </div>
        <div class="field span-2" data-show-when="project_type=Commercial">
          <label class="field__label" for="dr-business">Type of business<span class="opt">e.g. café, boutique, office, learning centre</span></label>
          <input id="dr-business" name="business_type" type="text" />
        </div>
        <div class="field span-2" data-show-when="project_type=Exterior & landscape">
          <label class="field__label" for="dr-plot">Plot / garden<span class="opt">approximate size and what it includes</span></label>
          <input id="dr-plot" name="plot_details" type="text" placeholder="e.g. 600 m² garden, pool planned" />
        </div>

        <div class="field">
          <label class="field__label" for="dr-size">Approximate size<span class="opt">m²</span></label>
          <input id="dr-size" name="size_m2" type="text" inputmode="numeric" placeholder="e.g. 120" />
        </div>
        <div class="field">
          <label class="field__label" for="dr-stage">Project stage</label>
          <select id="dr-stage" name="project_stage">
            <option value="">Select…</option>
            <option>Planning / about to buy</option>
            <option>Bare shell — not yet renovated</option>
            <option>Renovation under way</option>
            <option>Furnished — looking to redesign</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field span-2">
          <span class="field__label" id="dr-services-label">Services you are interested in</span>
          <div class="choices" role="group" aria-labelledby="dr-services-label">
            {services.map((s) => (
              <label class="choice"><input type="checkbox" name="services" value={s} /><span>{s}</span></label>
            ))}
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="dr-timeline">Desired timeline</label>
          <select id="dr-timeline" name="timeline">
            <option value="">Select…</option>
            <option>As soon as possible</option>
            <option>Within 1–3 months</option>
            <option>Within 3–6 months</option>
            <option>6 months or later</option>
            <option>Flexible</option>
          </select>
        </div>
        <div class="field">
          <label class="field__label" for="dr-budget">Overall project budget<span class="opt">optional</span></label>
          <select id="dr-budget" name="budget">
            <option value="">Prefer to discuss</option>
            <option>Under $10,000</option>
            <option>$10,000 – $30,000</option>
            <option>$30,000 – $75,000</option>
            <option>$75,000 – $150,000</option>
            <option>Above $150,000</option>
          </select>
        </div>

        <div class="field span-2">
          <label class="field__label" for="dr-message">Tell us about the project<span class="req" aria-hidden="true">*</span></label>
          <textarea id="dr-message" name="message" required minlength="10" placeholder="Your space, how you live or work in it, the atmosphere you imagine…" aria-describedby="dr-message-err"></textarea>
          <p class="field__error" id="dr-message-err" data-error-for="message"></p>
        </div>

        <div class="field span-2">
          <span class="field__label" id="dr-file-label">Plan or photos<span class="opt">optional · JPG, PNG, PDF · up to 8 MB</span></span>
          <div class="file" data-file>
            <svg class="file__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0-4.5 4.5M12 4l4.5 4.5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.2"/></svg>
            <span class="file__text" data-file-text>Drop a file here or <u>browse</u></span>
            <input type="file" name="attachment" accept="image/jpeg,image/png,image/webp,image/heic,application/pdf" aria-labelledby="dr-file-label" aria-describedby="dr-file-err" data-max-mb="8" />
          </div>
          <p class="field__error" id="dr-file-err" data-error-for="attachment"></p>
        </div>
      </div>
    </fieldset>

    <div class="field">
      <label class="consent">
        <input type="checkbox" name="consent" value="yes" required aria-describedby="dr-consent-err" />
        <span>I agree that the studio may contact me about this request. My details are used only to reply to this enquiry.</span>
      </label>
      <p class="field__error" id="dr-consent-err" data-error-for="consent"></p>
    </div>

    <div class="form__alert" role="alert" tabindex="-1" data-form-alert>
      <strong>Your request could not be sent.</strong>
      <span>Please check your connection and try again — or call <a href={site.phoneHref}>{site.phone}</a> / email <a href={`mailto:${site.email}`}>{site.email}</a>.</span>
    </div>

    <div class="form__footer">
      <p class="form__note">Every project starts with a conversation. The studio will contact you to discuss your space, your brief and next steps.</p>
      <button class="btn form__submit" type="submit" data-submit>
        <span data-submit-label>Send project request</span>
        <span class="spinner" aria-hidden="true"></span>
        <Arrow />
      </button>
    </div>
  </form>

  <FormSuccess
    title="Thank you — your request is with the studio."
    text="Jemma and the team will review your project and contact you shortly to arrange a first conversation."
  />
</div>
