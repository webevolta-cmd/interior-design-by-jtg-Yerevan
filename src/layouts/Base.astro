---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import defaultOg from '../assets/projects/burgundy-residence/dining.jpg';
import serifUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import jostUrl from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  headerTheme?: 'overlay' | 'solid';
  cta?: { label: string; href: string };
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  bodyClass?: string;
  footerCta?: boolean;
}

const {
  title,
  description,
  ogImage = defaultOg,
  ogImageAlt = 'Neoclassical dining room designed by Interior Design by JTG',
  headerTheme = 'solid',
  cta,
  schema,
  noindex = false,
  bodyClass,
  footerCta = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;
const fullTitle = title.includes('JTG') ? title : `${title} — Interior Design by JTG`;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f4efe8" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <noscript><style>.js [data-reveal]{opacity:1!important;transform:none!important;clip-path:none!important}</style></noscript>

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={bodyClass} id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header theme={headerTheme} cta={cta} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer showCta={footerCta} />
    <div class="cursor" aria-hidden="true" data-cursor><span data-cursor-label>View</span></div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
  .cursor {
    position: fixed;
    left: 0; top: 0;
    z-index: 200;
    width: 92px; height: 92px;
    margin: -46px 0 0 -46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--x, -200px), var(--y, -200px), 0) scale(0.4);
    transition: opacity 0.35s var(--ease-out), scale 0.5s var(--ease-expo);
    will-change: transform;
  }
  .cursor.is-active { opacity: 1; scale: 2.5; }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) { .cursor { display: none; } }
</style>
