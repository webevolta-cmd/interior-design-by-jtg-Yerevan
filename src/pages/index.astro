---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Testimonials from '../components/Testimonials.astro';
import { getProject } from '../data/projects';
import { testimonials } from '../data/testimonials';
import { software } from '../data/school';
import { studioSchema, schoolSchema, websiteSchema } from '../data/schema';

import heroDining from '../assets/projects/burgundy-residence/dining.jpg';
import heroArarat from '../assets/projects/ararat-view/bath.jpg';
import heroVilla from '../assets/projects/mediterranean-villa/pool.jpg';
import heroLiving from '../assets/projects/city-apartment/living.jpg';
import divStudio from '../assets/projects/burgundy-residence/hall.jpg';
import divSchool from '../assets/school/lesson.jpg';
import founderImg from '../assets/people/founder-event.jpg';
import founderSite from '../assets/people/founder-site-visit.jpg';
import schoolCert from '../assets/school/certificates.jpg';
import schoolSalone from '../assets/people/founder-salone-2026.jpg';
import schoolExpo from '../assets/school/expo-group.jpg';
import ctaStudio from '../assets/projects/patisserie/counter.jpg';
import ctaSchool from '../assets/school/graduates-2026.jpg';

const slides = [
  { src: heroDining, alt: 'Neoclassical dining room in burgundy, marble and brass with a crystal chandelier', title: 'Burgundy Neoclassical Residence', meta: 'Kentron, Yerevan · 2026', slug: 'burgundy-neoclassical-residence' },
  { src: heroArarat, alt: 'Stone bathing suite with a glass bath facing Mount Ararat at dusk', title: 'Suite with a View of Ararat', meta: 'Residential · 2026', slug: 'apartment-with-ararat-view' },
  { src: heroVilla, alt: 'White arched Mediterranean villa beside a long pool at dusk', title: 'Mediterranean Villa & Pool', meta: 'Exterior & landscape · 2026', slug: 'mediterranean-villa' },
  { src: heroLiving, alt: 'Contemporary living room with stone and timber media wall and linear fireplace', title: 'Contemporary City Apartment', meta: 'Residential · 2026', slug: 'contemporary-city-apartment' },
];

const featured = [
  'burgundy-neoclassical-residence',
  'apartment-with-ararat-view',
  'mediterranean-villa',
  'contemporary-city-apartment',
  'patisserie',
  'joined-apartment-kitchen',
].map((s) => getProject(s)!);

const baItems = [
  { slug: 'burgundy-neoclassical-residence', t: 0, tab: 'Dining room' },
  { slug: 'apartment-with-ararat-view', t: 0, tab: 'Ararat suite' },
  { slug: 'contemporary-city-apartment', t: 0, tab: 'Living room' },
  { slug: 'neoclassical-bedroom', t: 0, tab: 'Bedroom' },
].map((x) => {
  const p = getProject(x.slug)!;
  return { project: p, tr: p.transformations![x.t], tab: x.tab };
});

const pick = (names: string[]) => names.map((n) => testimonials.find((t) => t.name === n)!).filter(Boolean);
const mixed = pick(['Lusin Sahakyan', 'Anna Mamikonyan', 'Tatevik Urutian', 'Hasmik Hakobyan', 'Khandoot Dallakian', 'As Grigoryan', 'Susik Harutyunyan']);
const origin = Astro.site!;
---

<Base
  title="Interior Design Studio & School by JTG — Jemma Ter-Grigoryan, Yerevan"
  description="Interior design studio and interior design school in Yerevan, founded in 2022 by designer Jemma Ter-Grigoryan. Residential, commercial, exterior and landscape design — and practical courses in person and online."
  headerTheme="overlay"
  schema={[websiteSchema(origin), studioSchema(origin), schoolSchema(origin)]}
  footerCta={false}
>
  <!-- HERO -->
  <section class="hero on-night" data-hero-scroll data-slideshow data-interval="6800" aria-label="Featured work">
    <div class="hero__media" data-hero-media>
      {slides.map((s, i) => (
        <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
          <Img src={s.src} alt={s.alt} size="full" priority={i === 0} />
        </div>
      ))}
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__content container" data-hero-content>
      <p class="eyebrow hero__eyebrow" data-reveal style="--delay:0.15s"><span>Interior Design Studio &amp; School<span class="eb-sep"> · </span>Yerevan · Since&nbsp;2022</span></p>
      <h1 class="display hero__title" data-reveal="lines" style="--delay:0.25s">
        <span class="line-mask" style="--i:0"><span>Interiors that</span></span>
        <span class="line-mask" style="--i:1"><span>tell the <em>story</em></span></span>
        <span class="line-mask" style="--i:2"><span>first.</span></span>
      </h1>
      <div class="hero__lower">
        <p class="hero__lead" data-reveal style="--delay:0.7s">
          Designer Jemma Ter-Grigoryan and her studio create interiors, exteriors and gardens shaped around the way people live — and teach the craft at the studio’s own design school.
        </p>
        <div class="hero__ctas" data-reveal style="--delay:0.85s">
          <a class="btn btn--light" href="/interior-design/">Explore Interior Design <Arrow /></a>
          <a class="btn btn--ghost" href="/design-school/">Explore the School <Arrow /></a>
        </div>
      </div>
    </div>

    <div class="hero__bar container">
      <div class="hero__captions" aria-live="off">
        {slides.map((s, i) => (
          <a href={`/projects/${s.slug}/`} class:list={['hero__caption', { 'is-active': i === 0 }]} data-slide-caption tabindex={i === 0 ? undefined : -1}>
            <span class="hero__caption-title">{s.title}</span>
            <span class="hero__caption-meta">{s.meta} · Design visualisation</span>
          </a>
        ))}
      </div>
      <div class="hero__controls">
        <div class="hero__dots" role="group" aria-label="Choose slide">
          {slides.map((s, i) => (
            <button type="button" class="hero__dot" data-slide-go aria-current={i === 0 ? 'true' : 'false'} aria-label={`Show ${s.title}`}>
              <span class="hero__dot-fill"></span>
            </button>
          ))}
        </div>
        <span class="hero__count"><span data-slide-current>01</span> / {String(slides.length).padStart(2, '0')}</span>
        <button type="button" class="hero__pause" data-slide-pause aria-pressed="false" aria-label="Pause slideshow">
          <svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1v10M9 1v10" stroke="currentColor" stroke-width="1.4"/></svg>
          <svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7-4.5z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro section" id="practice">
    <div class="container grid-12">
      <div class="intro__label">
        <span class="eyebrow">The practice</span>
      </div>
      <div class="intro__body">
        <p class="intro__statement serif" data-reveal>
          One practice, <em>two directions.</em> A&nbsp;design studio that creates homes, commercial spaces and gardens — and a school where new designers learn the way the studio works.
        </p>
        <dl class="intro__facts" data-reveal style="--delay:0.15s">
          <div><dt>Founded</dt><dd>2022, central Yerevan</dd></div>
          <div><dt>Studio</dt><dd>Interior · Exterior · Landscape</dd></div>
          <div><dt>School</dt><dd>In person &amp; online<br />Armenian &amp; English</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- DIVISIONS -->
  <section class="divisions" aria-label="Studio and school">
    <a class="division" href="/interior-design/" data-cursor-target="Explore">
      <div class="division__media media" data-parallax>
        <Img src={divStudio} alt="Entrance hall with backlit stone, burgundy frame and crystal chandelier" size="half" />
      </div>
      <div class="division__body on-night-text">
        <span class="division__num">01 — Studio</span>
        <h2 class="division__title">Interior <em>Design</em></h2>
        <p class="division__text">Residential and commercial interiors, exterior and landscape design — planned around your life, visualised in detail and supported through implementation.</p>
        <span class="link">Explore Interior Design <Arrow /></span>
      </div>
    </a>
    <a class="division" href="/design-school/" data-cursor-target="Explore">
      <div class="division__media media" data-parallax>
        <Img src={divSchool} alt="Students working on laptops around a table in the JTG classroom, 3ds Max on screen" size="half" position="50% 70%" />
      </div>
      <div class="division__body on-night-text">
        <span class="division__num">02 — School</span>
        <h2 class="division__title">Design <em>School</em></h2>
        <p class="division__text">3ds Max, Corona Renderer, Photoshop and ArchiCAD / Revit — taught in small groups inside a working studio, in person or online.</p>
        <span class="link">Explore the Design School <Arrow /></span>
      </div>
    </a>
  </section>

  <!-- FOUNDER -->
  <section class="founder section">
    <div class="container grid-12">
      <div class="founder__media">
        <div class="founder__main media" data-reveal="mask">
          <Img src={founderImg} alt="Jemma Ter-Grigoryan at a JTG presentation event, standing beside a table of material samples and student work" size="half" position="78% 30%" />
        </div>
        <div class="founder__second media" data-reveal="mask" style="--delay:0.2s" data-speed="-0.12">
          <Img src={founderSite} alt="Jemma Ter-Grigoryan on a construction site holding a design visualisation" size="third" position="60% 40%" />
        </div>
      </div>
      <div class="founder__text">
        <span class="eyebrow">Founder &amp; lead designer</span>
        <h2 class="h2" data-reveal="lines">
          <span class="line-mask" style="--i:0"><span>Jemma</span></span>
          <span class="line-mask" style="--i:1"><span><em>Ter-Grigoryan</em></span></span>
        </h2>
        <blockquote class="founder__quote serif" data-reveal>
          “Design must tell the story first. Real comfort — visual and physical — is vital to any place we touch.”
        </blockquote>
        <div class="prose" data-reveal>
          <p>Jemma founded the studio and the school together in the centre of Yerevan in 2022. Her design work begins with mutual understanding — each client’s lifestyle, taste and the specifics of their space — so that every project is created individually.</p>
          <p>She leads the school alongside its teachers, presents graduates with their certificates herself, and takes students to trade fairs and on international design tours — from Dubai to Salone del Mobile in Milan.</p>
        </div>
        <a class="link" href="/about/">About Jemma <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="work section bg-stone">
    <div class="container">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow">Selected work · 2026</span>
          <h2 class="h2" data-reveal>Recent <em>projects</em></h2>
        </div>
        <div class="section-head__aside">
          <a class="link" href="/projects/">View the full portfolio <Arrow /></a>
        </div>
      </div>
      <div class="work__grid">
        {featured.map((p, i) => (
          <ProjectCard
            project={p}
            index={i + 1}
            class={`work__item work__item--${i + 1}`}
            size={i === 0 || i === 4 ? 'large' : 'half'}
            ratio={['4 / 3', '4 / 5', '4 / 5', '3 / 2', '16 / 10', '4 / 5'][i]}
            parallax
          />
        ))}
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <section class="transform section" aria-labelledby="transform-title">
    <div class="container">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow">Before / After</span>
          <h2 class="h2" id="transform-title" data-reveal>From bare walls to a <em>finished idea</em></h2>
        </div>
        <div class="section-head__aside">
          <p class="transform__note muted">Before: the studio’s photographs of the existing space. After: the studio’s design visualisation for the same room.</p>
        </div>
      </div>

      <div class="ba-tabs" role="tablist" aria-label="Choose a transformation" data-ba-tabs>
        {baItems.map((b, i) => (
          <button type="button" role="tab" id={`ba-tab-${i}`} aria-controls={`ba-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="ba-tab">
            <span class="index-num">{String(i + 1).padStart(2, '0')}</span> {b.tab}
          </button>
        ))}
      </div>
      {baItems.map((b, i) => (
        <div class="ba-panel" role="tabpanel" id={`ba-panel-${i}`} aria-labelledby={`ba-tab-${i}`} hidden={i !== 0}>
          <BeforeAfter before={b.tr.before} after={b.tr.after} beforeAlt={b.tr.beforeAlt} afterAlt={b.tr.afterAlt} size="full" />
          <div class="ba-panel__meta">
            <div>
              <span class="ba-panel__project serif">{b.project.title}</span>
              <span class="muted ba-panel__date"><span class="ba-panel__sep" aria-hidden="true"> · </span>{b.project.publishedLabel}</span>
            </div>
            <a class="link" href={`/projects/${b.project.slug}/`}>View project <Arrow /></a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SCHOOL PREVIEW -->
  <section class="school-preview section on-night" aria-labelledby="school-title">
    <div class="container grid-12">
      <div class="sp__intro">
        <span class="eyebrow">Interior Design School by JTG</span>
        <h2 class="h2" id="school-title" data-reveal="lines">
          <span class="line-mask" style="--i:0"><span>Learn the craft</span></span>
          <span class="line-mask" style="--i:1"><span>inside a <em>working</em></span></span>
          <span class="line-mask" style="--i:2"><span><em>studio.</em></span></span>
        </h2>
        <p class="lead" data-reveal>
          The school grew alongside the studio. Students learn on the same tools and the same kind of real projects — in small groups, with a personal approach, through to a portfolio and certificate.
        </p>
        <ul class="sp__software" role="list" data-reveal>
          {software.map((s) => (
            <li><span class="sp__sw-name serif">{s.name}</span><span class="sp__sw-role">{s.role}</span></li>
          ))}
        </ul>
        <ul class="sp__facts" role="list" data-reveal>
          <li>Small groups</li><li>In person or online</li><li>Armenian or English</li><li>Expos &amp; design tours</li>
        </ul>
        <div class="sp__ctas" data-reveal>
          <a class="btn" href="/design-school/">Explore the School <Arrow /></a>
          <a class="btn btn--ghost" href="/design-school/#apply">Request course information <Arrow /></a>
        </div>
      </div>
      <div class="sp__gallery">
        <figure class="sp__img sp__img--a">
          <div class="media" data-reveal="mask"><Img src={schoolCert} alt="Jemma Ter-Grigoryan presenting a graduation certificate to a student in front of the JTG logo wall" size="third" /></div>
          <figcaption class="caption"><span>Graduation, 2026</span></figcaption>
        </figure>
        <figure class="sp__img sp__img--b" data-speed="-0.08">
          <div class="media" data-reveal="mask" style="--delay:0.15s"><Img src={schoolSalone} alt="Jemma Ter-Grigoryan on the red staircase at Salone del Mobile, Milan" size="third" /></div>
          <figcaption class="caption"><span>Salone del Mobile, Milan 2026</span></figcaption>
        </figure>
        <figure class="sp__img sp__img--c">
          <div class="media" data-reveal="mask" style="--delay:0.25s"><Img src={schoolExpo} alt="Students of the school with the founder at a construction expo in Yerevan" size="half" /></div>
          <figcaption class="caption"><span>Students at an expo in Yerevan, May 2026</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- RECOGNITION -->
  <section class="recog section-sm" aria-label="Recognition and activity">
    <div class="container">
      <ul class="recog__list" role="list">
        <li data-reveal><span class="recog__k">Television</span><span class="recog__v serif">Featured on H1, Public TV of Armenia</span></li>
        <li data-reveal style="--delay:0.08s"><span class="recog__k">Lecture · 2026</span><span class="recog__v serif">“AI for interior designers?” — public talk with NUACA</span></li>
        <li data-reveal style="--delay:0.16s"><span class="recog__k">Open class</span><span class="recog__v serif">Armenian State Pedagogical University</span></li>
        <li data-reveal style="--delay:0.24s"><span class="recog__k">Design tours</span><span class="recog__v serif">Dubai INDEX&nbsp;· Qatar&nbsp;· Salone&nbsp;del&nbsp;Mobile</span></li>
      </ul>
    </div>
  </section>

  <Testimonials items={mixed} title="Clients & students, in their words" />

  <!-- FINAL CTA -->
  <section class="final" aria-label="Start here">
    <a class="final__panel" href="/interior-design/#request" data-cursor-target="Begin">
      <div class="final__media media"><Img src={ctaStudio} alt="Pâtisserie interior with curved timber and marble counter" size="half" /></div>
      <div class="final__body">
        <span class="eyebrow">For clients</span>
        <h2 class="final__title">Start an interior design <em>project</em></h2>
        <span class="link">Send a project request <Arrow /></span>
      </div>
    </a>
    <a class="final__panel" href="/design-school/#apply" data-cursor-target="Apply">
      <div class="final__media media"><Img src={ctaSchool} alt="Graduates of the school holding their certificates" size="half" position="50% 40%" /></div>
      <div class="final__body">
        <span class="eyebrow">For students</span>
        <h2 class="final__title">Apply or request <em>school information</em></h2>
        <span class="link">Send an enquiry <Arrow /></span>
      </div>
    </a>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    isolation: isolate;
    background: var(--night);
  }
  .hero__media { position: absolute; inset: 0; z-index: -2; transform-origin: 50% 30%; }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    clip-path: inset(0 0 0 100%);
    transition: clip-path 1.6s var(--ease-in-out), opacity 0s linear 1.6s;
  }
  .hero__slide :global(picture), .hero__slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__slide :global(img) { transform: scale(1.12); transition: transform 7.5s cubic-bezier(0.2, 0.6, 0.3, 1); }
  .hero__slide.is-active { opacity: 1; clip-path: inset(0 0 0 0); z-index: 2; transition: clip-path 1.6s var(--ease-in-out), opacity 0s; }
  .hero__slide.is-prev { opacity: 1; z-index: 1; clip-path: inset(0 0 0 0); transition: none; }
  .hero__slide.is-active :global(img) { transform: scale(1.0); }
  .hero__slide.is-prev :global(img) { transform: scale(1.0) translateX(-3%); transition: transform 1.6s var(--ease-in-out); }
  :global(.no-js) .hero__slide:first-child { opacity: 1; clip-path: none; }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(15 12 11 / 0.55) 0%, rgb(15 12 11 / 0.05) 28%, rgb(15 12 11 / 0) 45%, rgb(15 12 11 / 0.5) 78%, rgb(15 12 11 / 0.82) 100%),
      linear-gradient(90deg, rgb(15 12 11 / 0.35) 0%, rgb(15 12 11 / 0) 60%);
  }  @media (max-width: 600px) {
    .hero__shade { background: linear-gradient(180deg, rgb(15 12 11 / 0.55) 0%, rgb(15 12 11 / 0.3) 22%, rgb(15 12 11 / 0.38) 48%, rgb(15 12 11 / 0.62) 75%, rgb(15 12 11 / 0.86) 100%); }
  }

  .hero__content {
    align-self: end;
    padding-top: calc(var(--header-h) + 8vh);
    padding-bottom: clamp(28px, 4vh, 56px);
  }
  .hero__eyebrow { color: rgb(239 232 222 / 0.82); }
  .hero__title { margin-top: 1.5rem; color: #f6efe6; text-shadow: 0 1px 2px rgb(15 12 11 / 0.3), 0 2px 36px rgb(15 12 11 / 0.45); }
  .hero__title em { color: #e6c19c; }
  .hero__lower {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem 4rem;
    margin-top: clamp(1.75rem, 4vh, 3rem);
  }
  .hero__lead { max-width: 46ch; font-size: var(--fs-lead); line-height: 1.5; color: rgb(246 239 230 / 0.94); font-weight: 380; text-shadow: 0 1px 20px rgb(15 12 11 / 0.3); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__ctas .btn--ghost { --btn-fg: #f6efe6; border-color: rgb(246 239 230 / 0.45); }
  .hero__ctas .btn--ghost:hover { color: #f6efe6; border-color: var(--wine); }

  .hero__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid rgb(239 232 222 / 0.18);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(239 232 222 / 0.85);
  }
  .hero__captions { position: relative; min-height: 2.6em; flex: 1; }
  .hero__caption { position: absolute; inset: 0 auto auto 0; display: grid; gap: 0.2rem; opacity: 0; transform: translateY(8px); transition: opacity 0.6s var(--ease-out), transform 0.8s var(--ease-expo); pointer-events: none; }
  .hero__caption.is-active { opacity: 1; transform: none; pointer-events: auto; transition-delay: 0.45s; }
  .hero__caption-title { font-family: var(--font-serif); font-weight: 460; font-size: 0.95rem; letter-spacing: 0.02em; text-transform: none; color: #f6efe6; }
  .hero__caption-meta { opacity: 0.75; }
  .hero__controls { display: flex; align-items: center; gap: 1.25rem; }
  .hero__dots { display: flex; gap: 6px; }
  .hero__dot { position: relative; width: 44px; height: 24px; display: grid; align-items: center; }
  .hero__dot::before { content: ''; height: 1px; background: rgb(239 232 222 / 0.35); }
  .hero__dot-fill { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: #f6efe6; transform: scaleX(0); transform-origin: left; }
  .hero__dot[aria-current='true'] .hero__dot-fill { transform: scaleX(1); }
  :global(.is-running) .hero__dot[aria-current='true'] .hero__dot-fill { animation: dot-progress 6.8s linear both; }
  @keyframes dot-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .hero__count { min-width: 6ch; text-align: center; }
  .hero__pause { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid rgb(239 232 222 / 0.35); border-radius: 50%; }
  .hero__pause svg { width: 11px; height: 11px; }
  .hero__pause .i-play { display: none; }
  .hero__pause[aria-pressed='true'] .i-play { display: block; }
  .hero__pause[aria-pressed='true'] .i-pause { display: none; }

  @media (max-width: 900px) {
    .hero__lower { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero__dots { display: none; }
    .hero__ctas .btn { flex: 1 1 100%; }
    .hero__caption-meta { display: none; }
  }

  /* ---------- INTRO ---------- */
  .intro__label { grid-column: 1 / span 3; padding-top: 0.9rem; }
  .intro__body { grid-column: 4 / -1; }
  .intro__statement { font-size: clamp(1.75rem, 1.1rem + 2.5vw, 3.9rem); line-height: 1.12; letter-spacing: -0.009em; text-wrap: balance; }
  .intro__statement em { color: var(--wine); }
